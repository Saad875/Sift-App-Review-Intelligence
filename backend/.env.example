# --- Nebius Token Factory (OpenAI compatible) ---
# Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=your-nebius-api-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model ids exactly as listed in the Token Factory model catalog.
# MODEL_FAST: an NVIDIA Nemotron Nano model (high-volume review classification).
# MODEL_REASONING: an NVIDIA Nemotron Super or Ultra model (themes, backlog, competitors, replies).
MODEL_FAST=nvidia/NVIDIA-Nemotron-Nano-9B-v2
MODEL_REASONING=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5

# --- Tavily web search (competitor research) ---
TAVILY_API_KEY=your-tavily-api-key

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# --- Optional ---
# Comma separated origins allowed by CORS. Leave empty to allow all origins when DEBUG=True only.
CORS_ALLOWED_ORIGINS=
# Where the SQLite database lives (the Docker image uses /app/data/db.sqlite3).
SQLITE_PATH=
# Seconds before a single model call times out.
LLM_TIMEOUT_SECONDS=90
