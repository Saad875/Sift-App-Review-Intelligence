{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Sift backend",
      "detail": "Django dev server on 0.0.0.0:8000 using backend/.venv (phone: adb reverse tcp:8000 tcp:8000)",
      "type": "shell",
      "command": "${workspaceFolder}\backend\.venv\Scripts\python.exe",
      "args": ["manage.py", "runserver", "0.0.0.0:8000"],
      "options": { "cwd": "${workspaceFolder}\backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Forward port to phone",
      "type": "shell",
      "command": "adb reverse tcp:8000 tcp:8000",
      "problemMatcher": []
    }
  ]
}
