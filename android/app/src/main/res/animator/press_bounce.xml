<?xml version="1.0" encoding="utf-8"?>
<!-- Button press feedback: shrinks while pressed, springs back on release. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/motion_short"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleX"
                android:valueTo="@dimen/press_scale_button"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_short"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY"
                android:valueTo="@dimen/press_scale_button"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@integer/motion_extra_long"
                android:interpolator="@anim/overshoot_soft"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_extra_long"
                android:interpolator="@anim/overshoot_soft"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
