<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle press feedback for tappable cards, used alongside the ripple. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="@integer/motion_short"
                android:propertyName="scaleX"
                android:valueTo="@dimen/press_scale_card"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_short"
                android:propertyName="scaleY"
                android:valueTo="@dimen/press_scale_card"
                android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:duration="@integer/motion_short"
                android:propertyName="scaleX"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="@integer/motion_short"
                android:propertyName="scaleY"
                android:valueTo="1"
                android:valueType="floatType" />
        </set>
    </item>
</selector>
