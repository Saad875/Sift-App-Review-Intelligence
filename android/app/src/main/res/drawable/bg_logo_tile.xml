<?xml version="1.0" encoding="utf-8"?>
<!-- Glass tile that frames the logo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="@dimen/radius_xxl" />
    <gradient
        android:angle="315"
        android:endColor="@color/sift_glass"
        android:startColor="@color/sift_glass_strong" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/sift_glass_stroke" />
</shape>
