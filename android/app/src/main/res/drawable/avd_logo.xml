<?xml version="1.0" encoding="utf-8"?>
<!-- The Sift mark, animated: review dots drop into the funnel one after another, then reappear. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group android:name="dotLeft">
                <path
                    android:name="dotLeftPath"
                    android:fillColor="@color/brand_white"
                    android:pathData="M42,30m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
            </group>
            <group android:name="dotMiddle">
                <path
                    android:name="dotMiddlePath"
                    android:fillColor="@color/brand_white"
                    android:pathData="M54,26m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
            </group>
            <group android:name="dotRight">
                <path
                    android:name="dotRightPath"
                    android:fillColor="@color/brand_white"
                    android:pathData="M66,30m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
            </group>
            <group
                android:name="funnel"
                android:pivotX="54"
                android:pivotY="40">
                <path
                    android:fillColor="@color/brand_green"
                    android:pathData="M33,40L75,40C77.2,40 78.3,42.6 76.8,44.2L60,62L60,78C60,79.1 59.4,80.1 58.4,80.6L51.4,84.1C50.1,84.8 48,83.8 48,82.3L48,62L31.2,44.2C29.7,42.6 30.8,40 33,40Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="dotLeft">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="@integer/logo_drop_cycle"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:propertyName="translateY"
                android:repeatCount="infinite"
                android:valueFrom="0"
                android:valueTo="@dimen/logo_drop_distance"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="dotLeftPath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="@integer/logo_drop_cycle"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:propertyName="fillAlpha"
                android:repeatCount="infinite"
                android:valueFrom="1"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="dotMiddle">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="@integer/logo_drop_cycle"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:propertyName="translateY"
                android:repeatCount="infinite"
                android:startOffset="@integer/logo_drop_stagger"
                android:valueFrom="0"
                android:valueTo="@dimen/logo_drop_distance_middle"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="dotMiddlePath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="@integer/logo_drop_cycle"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:propertyName="fillAlpha"
                android:repeatCount="infinite"
                android:startOffset="@integer/logo_drop_stagger"
                android:valueFrom="1"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="dotRight">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="@integer/logo_drop_cycle"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:propertyName="translateY"
                android:repeatCount="infinite"
                android:startOffset="@integer/logo_drop_stagger_double"
                android:valueFrom="0"
                android:valueTo="@dimen/logo_drop_distance"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="dotRightPath">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="@integer/logo_drop_cycle"
                android:interpolator="@android:interpolator/accelerate_quad"
                android:propertyName="fillAlpha"
                android:repeatCount="infinite"
                android:startOffset="@integer/logo_drop_stagger_double"
                android:valueFrom="1"
                android:valueTo="0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
