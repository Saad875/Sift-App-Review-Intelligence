<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <com.sift.app.presentation.widget.AuroraView
        android:id="@+id/aurora"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_6">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="@style/Widget.Sift.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_close_pro"
                app:icon="@drawable/ic_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/orbGlow"
                android:layout_width="@dimen/pro_orb_glow"
                android:layout_height="@dimen/pro_orb_glow"
                android:background="@drawable/bg_orb_glow"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="@id/orb"
                app:layout_constraintEnd_toEndOf="@id/orb"
                app:layout_constraintStart_toStartOf="@id/orb"
                app:layout_constraintTop_toTopOf="@id/orb" />

            <FrameLayout
                android:id="@+id/orb"
                android:layout_width="@dimen/pro_orb_size"
                android:layout_height="@dimen/pro_orb_size"
                android:layout_marginTop="@dimen/space_4"
                android:background="@drawable/bg_orb"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/closeButton">

                <ImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_workspace_premium"
                    app:tint="@color/sift_primary_text" />
            </FrameLayout>

            <TextView
                android:id="@+id/previewBadge"
                style="@style/Sift.Badge"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/pro_preview_badge"
                android:textColor="@color/sift_primary_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/orb" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/pro_title"
                android:textAppearance="@style/TextAppearance.Sift.Hero"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/previewBadge" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:text="@string/pro_subtitle"
                android:textAppearance="@style/TextAppearance.Sift.Body.Secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/compareCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subtitle">

                <LinearLayout
                    android:id="@+id/compareRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_4"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_4"
                    android:paddingBottom="@dimen/space_2">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="noHideDescendants"
                        android:paddingBottom="@dimen/space_2">

                        <TextView
                            android:id="@+id/headerFeature"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/pro_compare_feature"
                            android:textAppearance="@style/TextAppearance.Sift.Label"
                            app:layout_constraintEnd_toStartOf="@id/headerFree"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/headerFree"
                            android:layout_width="@dimen/pro_column_width"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/pro_compare_free"
                            android:textAppearance="@style/TextAppearance.Sift.Label"
                            app:layout_constraintEnd_toStartOf="@id/headerPro"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/headerPro"
                            android:layout_width="@dimen/pro_column_width"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/pro_compare_pro"
                            android:textAppearance="@style/TextAppearance.Sift.Label"
                            android:textColor="@color/sift_primary_text"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <include
                android:id="@+id/planYearly"
                layout="@layout/item_pro_plan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/compareCard" />

            <include
                android:id="@+id/planMonthly"
                layout="@layout/item_pro_plan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/planYearly" />

            <FrameLayout
                android:id="@+id/continueContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/planMonthly">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/continueButton"
                    style="@style/Widget.Sift.Button.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pro_continue"
                    app:icon="@drawable/ic_workspace_premium" />

                <com.sift.app.presentation.widget.ShineView
                    android:id="@+id/shine"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/laterButton"
                style="@style/Widget.Sift.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/pro_maybe_later"
                android:textColor="@color/sift_text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/continueContainer" />

            <TextView
                android:id="@+id/previewNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:text="@string/pro_preview_note"
                android:textAppearance="@style/TextAppearance.Sift.Caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/laterButton" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
