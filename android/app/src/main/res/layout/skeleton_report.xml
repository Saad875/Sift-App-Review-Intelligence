<?xml version="1.0" encoding="utf-8"?>
<!-- Shimmer skeleton shaped like the report overview. -->
<com.sift.app.presentation.widget.ShimmerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/skeletonTabs"
            style="@style/Sift.Skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/skeleton_title_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.8"
            app:layout_constraintHorizontal_bias="0" />

        <View
            android:id="@+id/skeletonMetricA"
            style="@style/Sift.Skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_16"
            android:layout_marginTop="@dimen/space_6"
            android:layout_marginEnd="@dimen/space_2"
            app:layout_constraintEnd_toStartOf="@id/skeletonMetricB"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeletonTabs" />

        <View
            android:id="@+id/skeletonMetricB"
            style="@style/Sift.Skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_16"
            android:layout_marginStart="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_2"
            app:layout_constraintEnd_toStartOf="@id/skeletonMetricC"
            app:layout_constraintStart_toEndOf="@id/skeletonMetricA"
            app:layout_constraintTop_toTopOf="@id/skeletonMetricA" />

        <View
            android:id="@+id/skeletonMetricC"
            style="@style/Sift.Skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_16"
            android:layout_marginStart="@dimen/space_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/skeletonMetricB"
            app:layout_constraintTop_toTopOf="@id/skeletonMetricA" />

        <View
            android:id="@+id/skeletonDonut"
            android:layout_width="@dimen/donut_size"
            android:layout_height="@dimen/donut_size"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_skeleton_circle"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeletonMetricA" />

        <View
            android:id="@+id/skeletonCardA"
            style="@style/Sift.Skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_16"
            android:layout_marginTop="@dimen/space_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeletonDonut" />

        <View
            style="@style/Sift.Skeleton"
            android:layout_width="0dp"
            android:layout_height="@dimen/space_16"
            android:layout_marginTop="@dimen/space_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skeletonCardA" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.sift.app.presentation.widget.ShimmerLayout>
