<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/space_6"
    android:paddingEnd="@dimen/space_6">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/art"
        android:layout_width="0dp"
        android:layout_height="@dimen/welcome_art_height"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintBottom_toTopOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <View
            android:id="@+id/orbGlow"
            android:layout_width="@dimen/welcome_orb_glow"
            android:layout_height="@dimen/welcome_orb_glow"
            android:background="@drawable/bg_orb_glow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/orb"
            android:layout_width="@dimen/welcome_orb_size"
            android:layout_height="@dimen/welcome_orb_size"
            android:background="@drawable/bg_orb"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/welcome_icon_size"
                android:layout_height="@dimen/welcome_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/sift_primary_text"
                tools:src="@drawable/ic_search" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chipPrimary"
            style="@style/Widget.Sift.Card.Raised"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            app:cardCornerRadius="@dimen/radius_pill"
            app:layout_constraintBottom_toTopOf="@id/orb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2">

            <TextView
                android:id="@+id/chipPrimaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_2"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="@dimen/space_3"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Sift.BodySmall"
                android:textColor="@color/sift_text_primary"
                app:drawableTint="@color/sift_primary_text"
                tools:drawableStart="@drawable/ic_star"
                tools:text="300 reviews collected" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chipSecondary"
            style="@style/Widget.Sift.Card.Raised"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            app:cardCornerRadius="@dimen/radius_pill"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/orb"
            app:layout_constraintVertical_bias="0.8">

            <TextView
                android:id="@+id/chipSecondaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/space_2"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="@dimen/space_3"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/space_4"
                android:paddingBottom="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Sift.BodySmall"
                android:textColor="@color/sift_text_primary"
                app:drawableTint="@color/sift_primary_text"
                tools:drawableStart="@drawable/ic_upload_file"
                tools:text="CSV import" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Sift.Display"
        app:layout_constraintBottom_toTopOf="@id/body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/art"
        tools:text="Every review, in one place" />

    <TextView
        android:id="@+id/body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Sift.Body.Secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title"
        tools:text="Pull the latest App Store reviews for any app, or import a CSV export from Google Play Console." />
</androidx.constraintlayout.widget.ConstraintLayout>
