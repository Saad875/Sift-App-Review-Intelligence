<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sift_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/action_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/review_detail_title" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_8">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/reviewCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:id="@+id/stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Sift.Subtitle"
                        android:textColor="@color/sift_neutral"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="★★☆☆☆" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.Sift.Caption"
                        app:layout_constraintBottom_toBottomOf="@id/stars"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/stars"
                        app:layout_constraintTop_toTopOf="@id/stars"
                        tools:text="12 Mar 2026" />

                    <TextView
                        android:id="@+id/sentimentBadge"
                        style="@style/Sift.Badge"
                        android:layout_marginTop="@dimen/space_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/stars"
                        tools:text="@string/sentiment_negative" />

                    <TextView
                        android:id="@+id/categoryBadge"
                        style="@style/Sift.Badge"
                        android:layout_marginStart="@dimen/space_2"
                        app:layout_constraintBaseline_toBaselineOf="@id/sentimentBadge"
                        app:layout_constraintStart_toEndOf="@id/sentimentBadge"
                        tools:text="@string/category_bug" />

                    <TextView
                        android:id="@+id/severityBadge"
                        style="@style/Sift.Badge"
                        android:layout_marginStart="@dimen/space_2"
                        app:layout_constraintBaseline_toBaselineOf="@id/sentimentBadge"
                        app:layout_constraintStart_toEndOf="@id/categoryBadge"
                        tools:text="Severity 4/5" />

                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/badgesBottom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="bottom"
                        app:constraint_referenced_ids="stars,sentimentBadge,categoryBadge,severityBadge" />

                    <TextView
                        android:id="@+id/reviewTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.Sift.Title"
                        android:textIsSelectable="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/badgesBottom"
                        tools:text="Lost my notes" />

                    <TextView
                        android:id="@+id/reviewText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:textAppearance="@style/TextAppearance.Sift.Body"
                        android:textIsSelectable="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/reviewTitle"
                        tools:text="After the update my edits from the tablet disappeared when I opened the phone." />

                    <TextView
                        android:id="@+id/byline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:textAppearance="@style/TextAppearance.Sift.Caption"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/reviewText"
                        tools:text="maria_k · v4.2.1" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/summaryLabel"
                style="@style/Sift.SectionLabel"
                android:layout_marginTop="@dimen/space_5"
                android:text="@string/review_summary_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/reviewCard" />

            <TextView
                android:id="@+id/summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Sift.Body"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/summaryLabel"
                tools:text="Edits made on a tablet are lost after syncing to a phone." />

            <TextView
                android:id="@+id/themeLine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Sift.Caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/summary"
                tools:text="Theme: Sync loses recent edits" />

            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_6"
                android:background="@color/sift_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/themeLine" />

            <TextView
                android:id="@+id/replyLabel"
                style="@style/Sift.SectionLabel"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/review_reply_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider" />

            <TextView
                android:id="@+id/replyCaption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/review_reply_caption"
                android:textAppearance="@style/TextAppearance.Sift.BodySmall"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/replyLabel" />

            <TextView
                android:id="@+id/sampleNote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_sample_banner"
                android:drawablePadding="@dimen/space_2"
                android:padding="@dimen/space_3"
                android:text="@string/error_reply_sample"
                android:textAppearance="@style/TextAppearance.Sift.BodySmall"
                android:textColor="@color/sift_text_primary"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/sift_neutral"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/replyCaption"
                tools:visibility="visible" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/toneChips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:contentDescription="@string/cd_reply_tone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/sampleNote"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/toneFriendly"
                    style="@style/Widget.Sift.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tone_friendly" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/toneFormal"
                    style="@style/Widget.Sift.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tone_formal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/toneApologetic"
                    style="@style/Widget.Sift.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tone_apologetic" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/draftButton"
                style="@style/Widget.Sift.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/review_draft_reply"
                app:icon="@drawable/ic_auto_awesome"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/toneChips" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/draftProgress"
                style="@style/Widget.Sift.LinearProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:contentDescription="@string/review_drafting"
                android:indeterminate="true"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/draftButton" />

            <TextView
                android:id="@+id/replyError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:accessibilityLiveRegion="polite"
                android:drawablePadding="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.Sift.BodySmall"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error"
                app:drawableTint="@color/sift_negative"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/draftProgress"
                tools:text="Could not reach the Sift backend." />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/replyLayout"
                style="@style/Widget.Sift.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:hint="@string/review_reply_hint"
                android:visibility="gone"
                app:counterEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/replyError"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/replyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyReply"
                style="@style/Widget.Sift.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/action_copy"
                android:visibility="gone"
                app:icon="@drawable/ic_copy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/replyLayout"
                tools:visibility="visible" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/skeleton"
        layout="@layout/skeleton_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_4"
        android:layout_marginEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <include
        android:id="@+id/errorState"
        layout="@layout/view_state_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />
</androidx.constraintlayout.widget.ConstraintLayout>
