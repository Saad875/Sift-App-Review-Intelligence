    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/skeleton_row" />

        <include layout="@layout/skeleton_row" />

        <include layout="@layout/skeleton_row" />

        <include layout="@layout/skeleton_row" />

        <include layout="@layout/skeleton_row" />
    </LinearLayout>
</com.sift.app.presentation.widget.ShimmerLayout>
