<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:contentDescription="@string/cd_splash">

    <com.sift.app.presentation.widget.AuroraView
        android:id="@+id/aurora"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glowRing"
        android:layout_width="@dimen/splash_glow_size"
        android:layout_height="@dimen/splash_glow_size"
        android:background="@drawable/bg_orb_glow"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/logoTile"
        app:layout_constraintEnd_toEndOf="@id/logoTile"
        app:layout_constraintStart_toStartOf="@id/logoTile"
        app:layout_constraintTop_toTopOf="@id/logoTile" />

    <FrameLayout
        android:id="@+id/logoTile"
        android:layout_width="@dimen/splash_logo_tile"
        android:layout_height="@dimen/splash_logo_tile"
        android:background="@drawable/bg_logo_tile"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/wordmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:id="@+id/logoMark"
            android:layout_width="@dimen/splash_logo_icon"
            android:layout_height="@dimen/splash_logo_icon"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/avd_logo" />
    </FrameLayout>

    <TextView
        android:id="@+id/wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Sift.Hero"
        app:layout_constraintBottom_toTopOf="@id/tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoTile" />

    <TextView
        android:id="@+id/tagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_8"
        android:gravity="center"
        android:text="@string/splash_tagline"
        android:textAppearance="@style/TextAppearance.Sift.Body.Secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wordmark" />

    <TextView
        android:id="@+id/poweredBy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_8"
        android:gravity="center"
        android:text="@string/powered_by_short"
        android:textAppearance="@style/TextAppearance.Sift.Caption"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
