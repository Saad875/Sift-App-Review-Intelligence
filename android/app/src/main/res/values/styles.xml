<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cards -->
    <style name="Widget.Sift.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/sift_glass</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">@dimen/elevation_0</item>
        <item name="strokeColor">@color/sift_glass_stroke</item>
        <item name="strokeWidth">@dimen/stroke_hairline</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <style name="Widget.Sift.Card.Raised">
        <item name="cardBackgroundColor">@color/sift_glass_strong</item>
        <item name="strokeWidth">@dimen/elevation_0</item>
    </style>

    <style name="Widget.Sift.Card.Overlay">
        <item name="cardBackgroundColor">@color/sift_surface_overlay</item>
        <item name="cardCornerRadius">@dimen/radius_xl</item>
        <item name="cardElevation">@dimen/elevation_4</item>
        <item name="strokeWidth">@dimen/elevation_0</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Sift.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@animator/press_bounce</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@color/button_primary_background</item>
        <item name="android:textColor">@color/button_primary_content</item>
        <item name="iconTint">@color/button_primary_content</item>
        <item name="rippleColor">@color/sift_on_primary</item>
        <item name="android:paddingStart">@dimen/space_6</item>
        <item name="android:paddingEnd">@dimen/space_6</item>
    </style>

    <!-- Gradient call-to-action for onboarding and Pro. -->
    <style name="Widget.Sift.Button.Hero">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_button_gradient</item>
        <item name="android:minHeight">@dimen/button_height_hero</item>
        <item name="android:elevation">@dimen/elevation_0</item>
    </style>

    <!-- Compact gradient pill, for the Pro entry point in headers. -->
    <style name="Widget.Sift.Button.Hero.Small">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/space_0</item>
        <item name="android:paddingStart">@dimen/space_3</item>
        <item name="android:paddingEnd">@dimen/space_4</item>
        <item name="iconSize">@dimen/icon_xs</item>
        <item name="iconPadding">@dimen/space_1_5</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Tab</item>
        <item name="android:insetTop">@dimen/space_1</item>
        <item name="android:insetBottom">@dimen/space_1</item>
    </style>

    <style name="Widget.Sift.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:stateListAnimator">@animator/press_bounce</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="strokeColor">@color/button_outline_stroke</item>
        <item name="backgroundTint">@color/button_outlined_background</item>
        <item name="android:textColor">@color/sift_text_primary</item>
        <item name="iconTint">@color/sift_primary_text</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <!-- Buttons inside a MaterialButtonToggleGroup (the group shapes the outer corners). -->
    <style name="Widget.Sift.Button.Outlined.Segment">
        <item name="cornerRadius">@dimen/radius_lg</item>
        <item name="android:paddingStart">@dimen/space_2</item>
        <item name="android:paddingEnd">@dimen/space_2</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Sift.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:stateListAnimator">@animator/press_bounce</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Button</item>
        <item name="android:textColor">@color/sift_primary_text</item>
        <item name="iconTint">@color/sift_primary_text</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <style name="Widget.Sift.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:stateListAnimator">@animator/press_bounce</item>
        <item name="iconGravity">textStart</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@color/sift_surface_raised</item>
        <item name="android:textColor">@color/sift_text_primary</item>
        <item name="iconTint">@color/sift_primary_text</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <style name="Widget.Sift.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:stateListAnimator">@animator/press_bounce</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="iconTint">@color/sift_text_primary</item>
        <item name="iconSize">@dimen/icon_md</item>
        <item name="rippleColor">@color/ripple_primary</item>
    </style>

    <!-- Chips -->
    <style name="Widget.Sift.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">@dimen/stroke_hairline</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconTint">@color/sift_primary_text</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="rippleColor">@color/ripple_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Tab</item>
    </style>

    <style name="Widget.Sift.Chip.Input" parent="Widget.Material3.Chip.Input">
        <item name="chipBackgroundColor">@color/sift_surface_raised</item>
        <item name="chipStrokeWidth">@dimen/elevation_0</item>
        <item name="android:textColor">@color/sift_text_primary</item>
        <item name="closeIconTint">@color/sift_text_secondary</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Tab</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.Sift.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/sift_primary</item>
        <item name="boxBackgroundColor">@color/sift_glass</item>
        <item name="hintTextColor">@color/sift_primary_text</item>
        <item name="android:textColorHint">@color/sift_text_tertiary</item>
        <item name="startIconTint">@color/sift_text_secondary</item>
        <item name="endIconTint">@color/sift_text_secondary</item>
    </style>

    <style name="Widget.Sift.TextInputLayout.Search">
        <item name="boxCornerRadiusTopStart">@dimen/radius_xl</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_xl</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_xl</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_xl</item>
        <item name="boxStrokeWidth">@dimen/stroke_hairline</item>
        <item name="boxStrokeWidthFocused">@dimen/stroke_thin</item>
        <item name="boxStrokeColor">@color/search_box_stroke</item>
        <item name="startIconTint">@color/sift_primary_text</item>
    </style>

    <!-- App bars and tabs -->
    <style name="Widget.Sift.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.Sift.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Sift.Caption</item>
        <item name="navigationIconTint">@color/sift_text_primary</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
    </style>

    <style name="Widget.Sift.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicator">@drawable/bg_tab_indicator</item>
        <item name="tabIndicatorColor">@color/sift_primary</item>
        <item name="tabIndicatorHeight">@dimen/tab_indicator_height</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabIndicatorAnimationDuration">@integer/motion_long</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabTextColor">@color/tab_text</item>
        <item name="tabTextAppearance">@style/TextAppearance.Sift.Tab</item>
        <item name="tabRippleColor">@color/ripple_primary</item>
        <item name="tabMode">auto</item>
        <item name="tabGravity">start</item>
        <item name="tabMinWidth">@dimen/space_16</item>
    </style>

    <!-- Snackbar -->
    <style name="Widget.Sift.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/sift_surface_overlay</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Sift.Medium</item>
    </style>

    <style name="Widget.Sift.Snackbar.Text" parent="Widget.Material3.Snackbar.TextView">
        <item name="android:textColor">@color/sift_text_primary</item>
    </style>

    <style name="Widget.Sift.Snackbar.Button" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/sift_primary_text</item>
    </style>

    <!-- Progress -->
    <style name="Widget.Sift.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/sift_primary</item>
        <item name="trackColor">@color/sift_chart_track</item>
        <item name="trackCornerRadius">@dimen/radius_pill</item>
        <item name="trackThickness">@dimen/share_bar_height</item>
    </style>

    <!-- Default for every TextView: hyphenate long words (German, Russian, Swahili) instead of splitting them bare. -->
    <style name="Widget.Sift.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:hyphenationFrequency">normal</item>
        <item name="android:breakStrategy">high_quality</item>
    </style>

    <!-- Base Sift namespace style -->
    <style name="Sift" />

    <!-- Reusable text roles -->
    <style name="Sift.SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Label</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <!-- Small rounded badge used for type, effort and sentiment labels -->
    <style name="Sift.Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_2</item>
        <item name="android:paddingEnd">@dimen/space_2</item>
        <item name="android:paddingTop">@dimen/space_0_5</item>
        <item name="android:paddingBottom">@dimen/space_0_5</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:textAppearance">@style/TextAppearance.Sift.Caption</item>
        <item name="android:textColor">@color/sift_text_secondary</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Placeholder blocks inside shimmer skeletons -->
    <style name="Sift.Skeleton">
        <item name="android:background">@drawable/bg_skeleton</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
