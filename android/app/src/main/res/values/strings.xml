    <!-- Intro -->
    <string name="intro_headline">Turn app reviews into your next roadmap</string>
    <string name="intro_body">Sift reads every review, groups the complaints into themes and tells you what to fix or build next.</string>
    <string name="intro_feature_collect_title">Collect</string>
    <string name="intro_feature_collect_body">Pull the latest App Store reviews for any app, or import a CSV export from Google Play Console.</string>
    <string name="intro_feature_understand_title">Understand</string>
    <string name="intro_feature_understand_body">NVIDIA Nemotron classifies sentiment, category and severity in any language, then finds the themes.</string>
    <string name="intro_feature_act_title">Act</string>
    <string name="intro_feature_act_body">Get a ranked backlog with evidence, reply drafts and a web-researched competitor comparison.</string>
    <string name="intro_get_started">Get started</string>

